# -----------------------------------------------------------------------------
# NUTRICRED - ENVIROMENT VARIABLES TEMPLATE (.env.example)
# -----------------------------------------------------------------------------

# Application Environment
VITE_APP_ENV=development
VITE_APP_NAME="NutriCRED - Crecer mejor"
VITE_APP_URL=http://localhost:5173

# API Endpoints (Backend REST / GraphQL)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Database Configuration (PostgreSQL / Supabase - Production)
# VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# WhatsApp Business API Integration
VITE_WHATSAPP_API_URL=https://graph.facebook.com/v19.0
VITE_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
# WHATSAPP_ACCESS_TOKEN=your_backend_only_access_token_here

# Power BI Embedded Configuration (DirectQuery)
VITE_POWERBI_WORKSPACE_ID=your_workspace_id_here
VITE_POWERBI_REPORT_ID=your_report_id_here
# POWERBI_CLIENT_SECRET=your_client_secret_here

# Cryptographic Salt (Ley N° 29733 Data Audit Protection)
VITE_AUDIT_SALT_KEY=sample_salt_key_for_sha256_hashing
